# AZZY AI AGENTS v2.0 environment. Copy to infra/.env (never commit infra/.env).
# On EC2 this whole file is stored as the Secrets Manager secret `azzy/env`
# and written to /opt/azzy-ai-agents/infra/.env by infra/scripts/bootstrap.sh.

# ---- Mode -------------------------------------------------------------------
# 1 = deterministic stub LLM + simulated tools, no cloud keys needed.
# 0 = real Bedrock/Anthropic/OpenAI, real AWS/SSH/GitHub/Slack integrations.
DEMO=1
NEXT_PUBLIC_DEMO=1

# ---- Admin login (seeded at startup as role `admin`; demo credentials come from here, never from code) ----
OWNER_EMAIL=owner@azzy.local
OWNER_PASSWORD=change-me-now
# Failed/successful login attempts allowed per minute per IP (Redis token bucket) -> 429 above it.
LOGIN_RATE_LIMIT_PER_MIN=10
# OIDC is RESERVED and NOT implemented in v2.0 (local accounts + TOTP MFA only). Leave empty.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# openssl rand -hex 32
JWT_SECRET=change-me-generate-with-openssl-rand-hex-32
# Header X-Azzy-Webhook-Secret for POST /api/webhooks/cloudwatch
WEBHOOK_SECRET=change-me-generate-with-openssl-rand-hex-32

# ---- URLs -------------------------------------------------------------------
# Public origin (used in Slack links and emails). Set to https://your.domain after enable_tls.sh.
PUBLIC_BASE_URL=http://localhost
# How the Next.js server reaches the API inside the compose network.
API_INTERNAL_URL=http://api:8000
# uvicorn worker processes for the api container (1 is right for a 2 vCPU box).
UVICORN_WORKERS=1

# ---- Data stores ------------------------------------------------------------
POSTGRES_PASSWORD=azzy
DATABASE_URL=postgresql+asyncpg://azzy:azzy@postgres:5432/azzy
REDIS_URL=redis://redis:6379/0

# ---- Agents, memory, knowledge ---------------------------------------------
AGENTS_DIR=/app/packages/agents
# Uploaded knowledge files (.md/.txt/.pdf) live in the `knowledge` volume.
KNOWLEDGE_DIR=/data/knowledge
# Daily purge of knowledge documents / agent memories older than this (audited).
KNOWLEDGE_RETENTION_DAYS=365
MEMORY_RETENTION_DAYS=180
# Total daily LLM spend cap across all agents (per-agent caps live in packages/agents/*.yaml).
DAILY_BUDGET_USD=25

# ---- LLM gateway (DEMO=0) ---------------------------------------------------
# Bedrock is primary and authenticates with the EC2 instance role (no keys).
AWS_REGION=ap-south-1
# LiteLLM model id (keep the bedrock/ prefix); enable the model in the Bedrock console first.
BEDROCK_MODEL=bedrock/anthropic.claude-3-5-sonnet-20241022-v2:0
# Embeddings for the knowledge base (DEMO=0). 384 dims requested via dimensions=384.
EMBEDDINGS_MODEL=bedrock/amazon.titan-embed-text-v2:0
# Optional fallbacks.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---- Integrations (DEMO=0) --------------------------------------------------
# Approval requests are also posted here when set.
SLACK_WEBHOOK_URL=
# Comma-separated hosts that nuclei.scan / zap may target. Nothing else is ever scanned.
AUTHORIZED_TARGETS=staging.client-a.example.com
# github.read / github.branch_pr (fine-grained PAT: contents + pull requests).
GITHUB_TOKEN=
# Deployment module: GitLab pipelines (read) and Jenkins job inspection (read).
GITLAB_TOKEN=
JENKINS_URL=
JENKINS_TOKEN=
# gmail.draft / gmail.send / gcal.schedule: Google OAuth client + refresh token as ONE JSON string.
GMAIL_CREDENTIALS_JSON=
# zendesk.update
ZENDESK_SUBDOMAIN=
ZENDESK_EMAIL=
ZENDESK_API_TOKEN=

# ---- Tuning (every remaining azzy/config.py setting; defaults shown, uncomment to override) ----
# Where generated reports live (the `artifacts` volume).
#ARTIFACTS_DIR=/data/artifacts
# Optional read-only replica for the sql.query tool (defaults to DATABASE_URL).
#DATABASE_RO_URL=
# Session cookie lifetime (7 days) and how long an approval waits before it expires.
#SESSION_TTL_SECONDS=604800
#APPROVAL_TIMEOUT_SECONDS=3600
# Environment health probe interval; the API enforces a 60 s floor.
#HEALTH_PROBE_SECONDS=60
# Agent loops the worker runs at once (1-4; 2 fits the 2 vCPU pilot host).
#WORKER_CONCURRENCY=2
#DB_POOL_SIZE=5
#DB_MAX_OVERFLOW=5
#LOG_LEVEL=INFO

# ---- Host bootstrap only (read by infra/scripts/bootstrap.sh, not by containers) ---
# Normally supplied through the `azzy/tailscale` secret; leave empty here.
TAILSCALE_AUTHKEY=
# S3 bucket for infra/scripts/backup.sh (Terraform output `backup_bucket`).
BACKUP_BUCKET=

# Build the api image with semgrep/checkov/gitleaks/trivy (adds ~600 MB). nuclei/zap are never bundled.
WITH_SCANNERS=0
